+static float qwen35_softmax_prob_for_token(const float * logits, int vocab, int token) {
+    if (token < 0 || token >= vocab || vocab <= 0) return 0.0f;
+    float max_v = logits[0];
+    for (int i = 1; i < vocab; ++i) max_v = std::max(max_v, logits[i]);
